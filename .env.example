# ==============================================================================
# Intelligent Concierge System - Environment Configuration
# ==============================================================================

# Hardware Profile: Apple Silicon (M5 Pro / 16GB RAM)
# Tip: To utilize host Metal GPU at maximum speed (~50 tok/s), run native Ollama on macOS
# and set OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- MySQL Database Configuration ---
MYSQL_ROOT_PASSWORD=hotel_secret_root_2026
MYSQL_DATABASE=hotel_db
MYSQL_USER=hotel_user
MYSQL_PASSWORD=hotel_pass_2026
MYSQL_PORT=3306
DB_CONNECTION_STRING=Server=mysql-db;Port=3306;Database=hotel_db;User=hotel_user;Password=hotel_pass_2026;

# --- Qdrant Vector Database ---
QDRANT_HOST=qdrant-db
QDRANT_PORT=6333
QDRANT_COLLECTION=hotel_policies

# --- Ollama LLM Configuration ---
# Host Native Ollama (Apple Metal GPU / NVIDIA CUDA):
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_KEEP_ALIVE=30m

# --- .NET 10 Backend API ---
DOTNET_API_URL=http://dotnet-api:8080
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# --- Python AI Orchestrator ---
AI_ORCHESTRATOR_URL=http://ai-agent:8000
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- SvelteKit Frontend ---
PORT=3000
PUBLIC_AI_API_URL=http://localhost:8000
